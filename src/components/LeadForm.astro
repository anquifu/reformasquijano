---
import { business, services } from '../data/site.mjs';
import { indexingEnabled, retentionDays } from '../lib/config.mjs';
import Icon from './Icon.astro';
const { selected = '', source = Astro.url.pathname } = Astro.props;

---
<section class="quote-section section" id="presupuesto" aria-labelledby="quote-heading">
  <div class="quote-intro">
    <span class="eyebrow">Demos el primer paso</span>
    <h2 id="quote-heading">Cuéntanos qué necesitas</h2>
    <p>Describe el trabajo y dónde lo necesitas. El envío de la solicitud no confirma una cita.</p>
    <a class="quote-phone" href={business.tel} data-conversion="click_phone"><Icon name="phone" size={27} />{business.phone}</a>
    <p class="opening-hours">{business.hours[0]}<br />{business.hours[1]}</p>
    <a class="text-link" href={business.whatsapp} target="_blank" rel="noopener noreferrer" data-conversion="click_whatsapp"><Icon name="whatsapp-logo" />Escribir por WhatsApp</a>
  </div>
  <form class="lead-form" method="post" action="/api/solicitudes.php" data-lead-form>
    {!indexingEnabled && <p class="preview-note">Formulario de prueba: utiliza datos ficticios. La web aún no está publicada.</p>}
    <input type="hidden" name="csrf" value="" />
    <input type="hidden" name="requestId" value="" />
    <input type="hidden" name="source" value={source} />
    <div class="honeypot" aria-hidden="true"><label for="website">Sitio web</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
    <div class="form-grid">
      <div class="field"><label for="service">Servicio <span aria-hidden="true">*</span></label><select id="service" name="service" required aria-describedby="error-service"><option value="">Selecciona un servicio</option>{services.map(s => <option value={s.id} selected={s.id === selected}>{s.label}</option>)}</select><span class="field-error" id="error-service"></span></div>
      <div class="field"><label for="municipality">Municipio <span aria-hidden="true">*</span></label><select id="municipality" name="municipality" required aria-describedby="error-municipality"><option value="">Selecciona tu municipio</option>{business.areas.map(area => <option>{area}</option>)}</select><span class="field-error" id="error-municipality"></span></div>
      <div class="field"><label for="name">Nombre <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Tu nombre" aria-describedby="error-name" /><span class="field-error" id="error-name"></span></div>
      <div class="field"><label for="phone">Teléfono <span aria-hidden="true">*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required minlength="9" maxlength="25" placeholder="Tu teléfono de contacto" aria-describedby="error-phone" /><span class="field-error" id="error-phone"></span></div>
      <div class="field full"><label for="email">Correo electrónico <span class="optional">(opcional)</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="Tu correo, si prefieres que te escribamos" aria-describedby="error-email" /><span class="field-error" id="error-email"></span></div>
      <div class="field full"><label for="description">Describe el trabajo <span aria-hidden="true">*</span></label><textarea id="description" name="description" required minlength="15" maxlength="2500" rows="4" placeholder="Qué quieres cambiar, qué ocurre o qué necesitas…" aria-describedby="error-description"></textarea><span class="field-error" id="error-description"></span></div>
    </div>
    <details class="optional-details"><summary>Añadir presupuesto y fecha <span>(opcional)</span></summary>
      <div class="form-grid">
        <div class="field"><label for="budget">Tu presupuesto estimado</label><select id="budget" name="budget" aria-describedby="error-budget"><option value="">Prefiero recibir orientación</option><option value="menos-3000">Menos de 3.000 €</option><option value="3000-10000">De 3.000 a 10.000 €</option><option value="10000-30000">De 10.000 a 30.000 €</option><option value="mas-30000">Más de 30.000 €</option></select><small>Es tu previsión, no una tarifa del servicio.</small><span class="field-error" id="error-budget"></span></div>
        <div class="field"><label for="urgency">¿Cuándo lo necesitas?</label><select id="urgency" name="urgency" aria-describedby="error-urgency"><option value="sin-fecha">Todavía sin fecha</option><option value="proximamente">Me gustaría hacerlo próximamente</option><option value="fecha-prevista">Tengo una fecha aproximada</option><option value="consultar-disponibilidad">Quiero consultar disponibilidad</option></select><span class="field-error" id="error-urgency"></span></div>
        <div class="field full"><label for="startDate">Fecha aproximada de inicio</label><input id="startDate" type="date" name="startDate" aria-describedby="error-startDate" /><span class="field-error" id="error-startDate"></span></div>
      </div>
    </details>
    <label class="consent"><input type="checkbox" name="privacy" value="accepted" required aria-describedby="error-privacy" /><span>He leído la <a href="/privacidad/">información de privacidad</a> y acepto el tratamiento de estos datos para gestionar mi solicitud.</span></label><span class="field-error" id="error-privacy"></span>
    <p class="privacy-summary">Responsable: Andrea Quijano. Usamos estos datos para atender tu consulta, no para enviarte publicidad. Conservación técnica de solicitudes: {retentionDays} días. Consulta los detalles y tus derechos en <a href="/privacidad/">privacidad</a>.</p>
    <button class="button button-primary form-submit" type="submit">Solicitar presupuesto <Icon name="arrow-right" size={20} /></button>
    <div class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></div>
    <noscript><p>Para enviar sin JavaScript, <a href="/api/formulario.php">abre el formulario accesible</a>.</p></noscript>
  </form>
</section>
