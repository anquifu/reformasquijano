---
import { business, homeFaqs } from '../data/site.mjs';
import Icon from './Icon.astro';
import ServiceGrid from './ServiceGrid.astro';
import Coverage from './Coverage.astro';
import FAQ from './FAQ.astro';
import LeadForm from './LeadForm.astro';
---
<section class="hero" aria-labelledby="hero-heading">
  <img class="hero-image" src="/images/salon-cocina-roble-luz-natural-1680.webp" srcset="/images/salon-cocina-roble-luz-natural-640.webp 640w, /images/salon-cocina-roble-luz-natural-960.webp 960w, /images/salon-cocina-roble-luz-natural-1680.webp 1680w" sizes="100vw" width="1680" height="935" fetchpriority="high" loading="eager" alt="Salón luminoso con cocina de roble, isla y mesa de comedor" />
  <div class="hero-shade"></div>
  <div class="container hero-content">
    <span class="hero-location"><Icon name="map-pin" size={20} /> A Coruña</span>
    <h1 id="hero-heading">Reformas en A Coruña</h1>
    <p>Reformas en A Coruña para cocinas, baños y pisos. Pladur, techos y servicios para tu vivienda.</p>
    <div class="hero-actions"><a class="button button-primary" href="#presupuesto">Solicitar presupuesto <Icon name="arrow-right" size={20} /></a><a class="button button-outline" href={business.whatsapp} target="_blank" rel="noopener noreferrer" data-conversion="click_whatsapp"><Icon name="whatsapp-logo" />Escribir por WhatsApp</a></div>
  </div>
  <small class="image-caption">Imagen ilustrativa. No es una obra propia.</small>
</section>
<div class="container page-content">
  <ServiceGrid />
  <section class="why-section section" aria-labelledby="why-heading">
    <div class="section-heading"><span class="eyebrow">Reformas Quijano</span><h2 id="why-heading">¿Por qué elegirnos?</h2></div>
    <div class="reasons"><div><Icon name="house-line" size={36} /><div><h3>Tu vivienda, en conjunto</h3><p>Pisos, cocinas, baños, pladur y techos. Consulta por una estancia o por varias zonas de tu casa.</p></div></div><div><Icon name="key" size={36} /><div><h3>También lo cotidiano</h3><p>Desatascos y apertura de puertas, con vías de contacto propias para explicar tu incidencia.</p></div></div></div>
  </section>
  <section class="section process-section" aria-labelledby="process-heading">
    <div class="section-heading"><span class="eyebrow">Del primer contacto a la propuesta</span><h2 id="process-heading">Empecemos por tu idea</h2><p>Concretar el trabajo es el primer paso para pedir presupuesto.</p></div>
    <ol class="process-list"><li><span class="step-number">01</span><h3>Cuéntanos qué necesitas</h3><p>El servicio, tu municipio y lo que quieres cambiar o resolver.</p></li><li><span class="step-number">02</span><h3>Definamos el alcance</h3><p>Qué debe incluir la propuesta y qué información hace falta revisar.</p></li><li><span class="step-number">03</span><h3>Valora la propuesta</h3><p>Revisa trabajos, condiciones y disponibilidad antes de acordar una intervención.</p></li></ol>
  </section>
  <Coverage />
  <FAQ items={homeFaqs} />
  <LeadForm source="/" />
</div>
