# Desarrollo privado; no activa indexación ni publica nada.
PUBLIC_SITE_URL=https://reformasquijano.online
SITE_INDEXING=false
HOST=0.0.0.0
PORT=4321
# Ruta fuera de public/. Montar volumen persistente en producción.
LEADS_DB=./var/leads.sqlite
LEAD_RETENTION_DAYS=30
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=
# No configurar credenciales en el repositorio. Valores seguros del hosting.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=info@reformasquijano.online
LEAD_EMAIL=info@reformasquijano.online
# Mantener 0 salvo proxy confiable que reescriba X-Forwarded-For.
TRUST_PROXY=0
